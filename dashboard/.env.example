# ===== ZiGBoT dashboard (Vercel) =====
# Copy to .env.local for local development. In Vercel, add these under
# Project -> Settings -> Environment Variables. NEVER commit real values.

# --- Public (safe in the browser; RLS protects the data) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key
# Your production URL, used for OAuth redirects and the CSRF origin check.
NEXT_PUBLIC_SITE_URL=https://your-dashboard.vercel.app

# --- Server-only secrets (never prefix with NEXT_PUBLIC_) ---
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_CLIENT_ID=your-discord-application-id
# Optional: enables the "Test" tab (same key the bot uses).
NVIDIA_API_KEY=your-nvidia-api-key
AI_MODEL=openai/gpt-oss-20b

# Optional: your own server(s) keep the legacy env-driven role rules when seeded.
HOME_GUILD_IDS=
BOT_CREATOR_ID=
# Optional: custom bot identity pictures go live as soon as an admin saves.
# Set to true to make each new picture wait for BOT_CREATOR_ID's review at /owner/identity.
# IDENTITY_AVATAR_REVIEW=

# --- ZiGBoT Premium via Razorpay Subscriptions (optional) ---
# Checkout is enabled once the key ID, key secret and both plan IDs are set.
# The webhook secret is needed for renewals/cancellations (the webhook route).
# NEVER prefix the key secret with NEXT_PUBLIC_.
# Test-mode keys (rzp_test_...) work the same way as live keys (rzp_live_...).
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=the-secret-you-set-on-the-webhook
RAZORPAY_PLAN_MONTHLY=plan_your_monthly_plan_id
RAZORPAY_PLAN_YEARLY=plan_your_yearly_plan_id
# Display-only price labels for the upgrade buttons.
PREMIUM_PRICE_MONTHLY=₹399/month
PREMIUM_PRICE_YEARLY=₹3,999/year
