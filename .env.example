DISCORD_TOKEN=replace_with_discord_bot_token
NVIDIA_API_KEY=replace_with_nvidia_api_key
SERVER_OWNER_ID=1296202178263912448
SERVER_OWNER_ROLE_NAME=꧁༺ ZiG ༻꧂
AI_MODEL=openai/gpt-oss-20b
LOG_CHANNEL_ID=1539605903647440946

# Auto-Reply & Mingling Settings
RESPOND_TO_ALL_MESSAGES=false
CHAT_CHANNEL_IDS=
AUTO_REPLY_KEYWORDS=false
COOLDOWN_SECONDS=15
# Faster reply pacing keeps the bot feeling snappy while still feeling human.
REPLY_TYPING_WPM_MIN=80
REPLY_TYPING_WPM_MAX=140
REPLY_TYPING_DELAY_MIN_MS=250
REPLY_TYPING_DELAY_MAX_MS=2200
REPLY_MULTI_MESSAGE_BASE_GAP_MS=350
REPLY_MULTI_MESSAGE_JITTER_MS=200
REPLY_MULTI_MESSAGE_SPLIT_CHANCE=0.12
HUMOR_STYLE=witty_stress_relief

# Gentle Mode Roles (Comma-separated list of roles that receive gentle, wholesome treatment)
GENTLE_ROLE_NAMES=ｓｈｅ ﹒ ｈｅｒ, she/her, ｈｅ ﹒ ｈｉｍ, he/him, ｇｅｎｔｌｅｍａｎ, Gentleman, 👑 King, King, ｓｏｆｔ ｂｏｙ, Soft Boy, Chill Guy, Chill Bro, Girl, Female, Queen, Princess, Gentle, Wholesome, Softie, 🏷️ Heer Tag
FEMALE_ROLE_NAMES=ｓｈｅ ﹒ ｈｅｒ, she/her
MALE_ROLE_NAMES=ｈｅ ﹒ ｈｉｍ, he/him
FEMALE_ROLE_IDS=1367088122873253988
MALE_ROLE_IDS=1367086916142366760
NON_GENTLE_ROLE_NAMES=Users.heer

# Voice Settings
VOICE_MODE=push-to-talk
STORE_TRANSCRIPTS=false

# NVIDIA hosted speech (default): uses the SAME NVIDIA_API_KEY as chat.
# No local binaries needed, works on Render free tier. Set NVIDIA_SPEECH=false
# to fall back to local STT/TTS executables below.
NVIDIA_SPEECH=true
# Optional overrides:
# NVIDIA_ASR_FUNCTION_ID=
# NVIDIA_TTS_ENDPOINT=
# NVIDIA_TTS_LANGUAGE=en-US
# NVIDIA_TTS_VOICE=Magpie-Multilingual.EN-US.Aria

# Speech-to-text with Whisper large-v3 on Groq (used first when set; NVIDIA is the fallback)
# GROQ_API_KEY=gsk_your_key
# GROQ_STT_MODEL=whisper-large-v3-turbo   # or whisper-large-v3 (slower, a bit more accurate)
# GROQ_CHAT_MODEL=openai/gpt-oss-20b  # voice-chat replies on Groq (text chat uses NVIDIA AI_MODEL); each backs up the other

# Speaking voice with Sarvam AI Bulbul (Indian voices; used first when set; NVIDIA is the fallback)
# SARVAM_API_KEY=your_sarvam_key
# SARVAM_VOICE=shubh          # bulbul:v3 speakers, e.g. shubh, aditya, rahul, priya, kavya, neha, simran
# SARVAM_MODEL=bulbul:v3
# SARVAM_PACE=1.0             # 0.5-2.0

# Legacy local STT/TTS (fallback when NVIDIA_SPEECH=false)
STT_COMMAND=
STT_ARGS=[]
TTS_COMMAND=
TTS_ARGS=[]
STT_TIMEOUT_MS=60000
TTS_TIMEOUT_MS=60000

# ===== Multi-server dashboard (Supabase) =====
# Leave both empty to run in legacy single-server mode (env-only config).
# The service-role key is a SECRET: only this worker and the dashboard's
# server-side routes may hold it. Never put it in frontend/NEXT_PUBLIC_ vars.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_service_role_key
# Your own server(s): seeded with the legacy env-driven role rules below.
# (A server whose Discord owner is SERVER_OWNER_ID is also treated as home.)
HOME_GUILD_IDS=
# Creator identity used in "who made you" answers (defaults to SERVER_OWNER_ID).
BOT_CREATOR_ID=

# Per-guild owners/admins (legacy multi-server env, still supported). JSON: {"<guildId>": {"ownerId": "...", "adminRoleNames": ["..."]}}
# SERVER_OWNER_ID stays as the fallback for single-server setups.
GUILD_CONFIG=

# AI quota protection per user (independent of chat cooldowns)
AI_RATE_LIMIT_MAX=8
AI_RATE_LIMIT_WINDOW_SECONDS=60
# Per-user AI limit in ZiGBoT Premium servers (same window). Free servers use AI_RATE_LIMIT_MAX.
AI_RATE_LIMIT_PREMIUM_MAX=30

# Slash commands: leave empty to register globally, or comma-separated guild IDs for instant guild-only registration
SLASH_COMMAND_GUILD_IDS=

# MongoDB Atlas connection string (see cloud.mongodb.com, free M0 tier)
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/?appName=Cluster0

# Opt-in conversation summaries (default false). Even when true, a member is
# summarised only after /memory summaries state:on, with memory on. Needs GROQ_API_KEY.
MEMORY_SUMMARIES_ENABLED=false
# Optional: comma-separated server IDs to limit summaries to. Empty = every server.
# MEMORY_SUMMARIES_GUILDS=
# Optional: Groq model for summaries (default openai/gpt-oss-20b; it must support
# JSON mode). llama-3.1-8b-instant was retired for free/developer keys on 2026-08-16.
# GROQ_SUMMARY_MODEL=
# Also summarise opted-in members' own messages in the channels admins add with
# /summarychannels (default false). Needs MEMORY_SUMMARIES_ENABLED=true too.
MEMORY_SUMMARIES_CHANNELS_ENABLED=false

# Integration tests only: a DISPOSABLE MongoDB URI (never production). Tests use
# a random zigbot_test_* database on it and drop only that database afterwards.
# Unset = integration tests are skipped.
# MONGODB_TEST_URI=

# ===== YouTube Live Chat (optional; all three required to enable) =====
# 1. Google Cloud project + enable "YouTube Data API v3" (see README).
# 2. OAuth client (Web application) with redirect URI http://127.0.0.1:5455/oauth-callback
# 3. Run `node scripts/youtube-auth.js` locally, paste the printed refresh token below.
# NOTE: while the OAuth consent screen is in "Testing" status, the refresh token
# EXPIRES after 7 days and must be re-issued. Move the app to "In production".
YOUTUBE_CLIENT_ID=replace_with_google_oauth_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=replace_with_google_oauth_client_secret
YOUTUBE_REFRESH_TOKEN=replace_with_refresh_token_from_scripts_youtube_auth

# Owner channel handle (used for channels.list forHandle). The bot reads chat
# for THIS channel's live streams. Default: @YourBoyZiG
YOUTUBE_OWNER_HANDLE=@YourBoyZiG
# Optional literal channel id override; skips the forHandle lookup.
# YOUTUBE_OWNER_CHANNEL_ID=

# Optional explicit bot-channel id (the identity whose OAuth token we hold).
# When omitted, the bot resolves its own id via channels.list(mine=true).
# YOUTUBE_BOT_CHANNEL_ID=

# Auto-detect the owner's live streams (uploads-playlist polling). Default on.
# Set false to require the manual owner-only /watch <videoId> Discord command.
YOUTUBE_AUTO_DETECT=true
# Detection poll interval in ms (default 180000 = 3 min; min 60000 = 1 min).
YOUTUBE_DETECT_INTERVAL_MS=180000
# Never poll live chat faster than this, even when YouTube suggests a shorter interval (default 8000 ms).
YOUTUBE_MIN_POLL_MS=8000
YOUTUBE_DISCORD_CHANNEL_ID=1366908121754239009
YOUTUBE_DISCORD_ROLE_ID=1366912959510478868
# Optional active-hours window HH-HH in server local time, e.g. 18-2 = 18:00-02:00
# YOUTUBE_ACTIVE_HOURS=

# Daily YouTube API quota safety budget, units (default 10000 = real Google cap).
# Set lower to leave headroom under other apps sharing the same Google project.
YOUTUBE_QUOTA_BUDGET=10000
# Enable greeting and direct-mention replies (default true).
YOUTUBE_GREETINGS=true
# Legacy YouTube-chat engagement prompts (default false).
YOUTUBE_ENGAGEMENT_PROMPTS=false
# Channel IDs that greetings must ignore, comma-separated.
# YOUTUBE_IGNORE_CHANNEL_IDS=
# Bot channel display name for mention detection if channels.list title is unavailable.
YOUTUBE_BOT_NAME=ZiGBoT
# Keep this much daily API quota unused for other YouTube calls (default 2500 units).
YOUTUBE_QUOTA_RESERVE=2500
# Maximum outgoing replies in one stream (default 60).
YOUTUBE_MAX_REPLIES_PER_STREAM=60
# Greeting text must be at most this many normalized words (default 6).
YOUTUBE_GREETING_MAX_WORDS=6
# Ignore messages published before watcher start minus this tolerance (default 3000 ms).
YOUTUBE_BACKLOG_TOLERANCE_MS=3000
# Minimum gap between outgoing YouTube chat replies (default 5000 ms).
YOUTUBE_REPLY_INTERVAL_MS=5000
# Maximum waiting/in-flight greeting replies before new ones are dropped (default 10).
YOUTUBE_REPLY_QUEUE_MAX=10
# Per-viewer direct-mention cooldown in milliseconds (default 60000).
YOUTUBE_MENTION_COOLDOWN_MS=60000
# Owner-only moderation commands are enabled by default.
YOUTUBE_MODERATION=true
# YouTube live-chat command prefix (default !).
YOUTUBE_COMMAND_PREFIX=!
# Preserve this much daily YouTube quota for unrelated calls (default 400 units).
YOUTUBE_MOD_QUOTA_RESERVE=400
# Maximum YouTube moderation API actions in one stream (default 25).
YOUTUBE_MAX_MOD_ACTIONS_PER_STREAM=25
# Minimum spacing between ban/timeout actions in milliseconds (default 2000).
YOUTUBE_MOD_ACTION_COOLDOWN_MS=2000
# Enables the owner-only YouTube roast commands (default true); roast mode still starts OFF every stream.
YOUTUBE_ROAST=true
# Allow roasts of paying members (default false).
YOUTUBE_ROAST_MEMBERS=false
# Maximum successful roasts in one stream (default 25).
YOUTUBE_MAX_ROASTS_PER_STREAM=25
# Minimum delay between generated roasts (default 10000 ms).
YOUTUBE_ROAST_INTERVAL_MS=10000
# Per-viewer roast cooldown (default 120000 ms).
YOUTUBE_ROAST_VIEWER_COOLDOWN_MS=120000
# NVIDIA request timeout for YouTube roasts (default 8000 ms).
YOUTUBE_ROAST_AI_TIMEOUT_MS=8000
# YouTube-only NVIDIA rate bucket (default 2 calls per 60000 ms).
YOUTUBE_ROAST_AI_RATE_LIMIT_MAX=2
YOUTUBE_ROAST_AI_RATE_LIMIT_WINDOW_MS=60000

# Music — see MUSIC.md. yt-dlp is downloaded into bin/ on `npm install`; ffmpeg comes from ffmpeg-static.
# MUSIC_SOURCE=youtube       # where song-name searches go first: youtube (default) or soundcloud.
#                            # YouTube tracks this host cannot stream fall back to SoundCloud automatically.
# MUSIC_STREAM_TIMEOUT_SECONDS=45  # optional: how long to wait for a song to start (slow free hosts need more)
# YTDLP_PATH=                # optional: use your own yt-dlp binary instead
# YTDLP_SKIP_DOWNLOAD=1      # optional: do not download yt-dlp during npm install
# YTDLP_COOKIES_FILE=        # optional: path to a cookies.txt from your own YouTube login
